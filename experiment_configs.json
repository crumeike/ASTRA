{
  "base_config": {
    "experiment_name": "tornado_damage",
    "save_dir": "experiments",
    "seed": 42,
    "pretrained": true,
    "data_dir": "/path/to/tornado_data",
    "epochs": 100,
    "patience": 10,
    "scheduler": "cosine"
  },
  "param_grid": {
    "model": ["resnet18", "resnet50", "efficientnet_b0", "efficientnet_b3", "vit_b_16"],
    "input_size": [224, 384, 448],
    "batch_size": [16, 32, 64],
    "optimizer": ["adam", "adamw", "sgd"],
    "lr": [0.001, 0.0005, 0.0001],
    "weight_decay": [0.0, 0.0001, 0.001],
    "data_augmentation": ["basic", "standard", "advanced"],
    "activation": ["relu", "swish", "gelu"],
    "loss": ["cross_entropy", "focal"]
  }
}